    "import matplotlib.pyplot as plt\n",
    "\n",
    "import numpy as np"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "9ab6bd2e-c9fa-4b86-a414-4292d233604b",
   "metadata": {},
   "outputs": [],
   "source": [
    "x = np.linspace(0, 100, 100)\n",
    "y = np.sqrt(x)\n",
    "\n",
    "plt.plot(y, label = \"y = √x\")\n",
    "plt.xlabel(\"x\")\n",
    "plt.ylabel(\"y = √x\")\n",
    "plt.legend()\n",
    "plt.title(\"Graph of y = √x\")\n",
    "plt.grid()"
   ]
